  hintText:
  - "\u4F60\u597D\uFF0C\u9019\u88E1\u662F\u6D88\u9632\u968A\uFF0C\u76EE\u524D\u9019\u68DF\u516C\u5BD3\u5DF2\u7D93\u767C\u751F\u706B\u707D\u4E86"
  - "\u6211\u5011\u63A5\u7372\u901A\u5831\u5F97\u77E5\u4F60\u9084\u5728\u4E09\u6A13\uFF0C\u4E0D\u7528\u64D4\u5FC3\uFF0C\u6211\u5011\u6703\u5F15\u5C0E\u4F60\u5B89\u5168\u7684\u9003\u96E2"
  - "\u8ACB\u5148\u5230\u6D74\u5BA4\u62FF\u4E00\u584A\u62B9\u5E03\u4E26\u4E14\u6CBE\u6FD5\uFF0C\u7528\u62B9\u5E03\u4F86\u906E\u4F4F\u53E3\u9F3B\uFF0C\u907F\u514D\u88AB\u6FC3\u7159\u55C6\u5230"
